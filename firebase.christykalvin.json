{
  "hosting": {
    "site": "christykalvin",
    "public": "public",
    "ignore": [
      "firebase.json",
      "firebase.christykalvin.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [{
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }]
  }
}
